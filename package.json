{
  "name": "open-ehr-mobile",
  "version": "0.1.0",
  "description": "A pure frontend mobile EHR demo app built with Vue 3, Vite, TypeScript, and mock data.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4180",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "verify:oss": "node scripts/verify-open-source.mjs",
    "test:smoke": "node scripts/playwright-smoke.mjs"
  },
  "dependencies": {
    "vue": "^3.5.30",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "playwright": "^1.60.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.1",
    "vue-tsc": "^3.0.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
